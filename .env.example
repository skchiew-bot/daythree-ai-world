# Daythree AI World — Phase 0 local environment
# Copy to .env and adjust. Never commit the real .env file.

# --- Core ---
# ENVIRONMENT=dev never enforces the checks below; set ENVIRONMENT=production (or
# anything else) once this is a real deployment and Settings.require_safe_for_production()
# (called at API/worker startup) will refuse to start if SECRET_KEY or
# OBJECT_STORE_SECRET_KEY are still these placeholder values.
ENVIRONMENT=dev
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=daythree
POSTGRES_USER=daythree
POSTGRES_PASSWORD=daythree_dev_password
DATABASE_URL=postgresql+asyncpg://daythree:daythree_dev_password@localhost:5432/daythree

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=daythree.events

# --- Object storage (MinIO, S3-compatible) ---
OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=daythree_minio
OBJECT_STORE_SECRET_KEY=daythree_minio_secret
OBJECT_STORE_BUCKET=daythree-artifacts
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_SIGNED_URL_TTL_SECONDS=300

# --- Model gateway ---
# Leave blank to force the MockModelProvider (no external calls, no cost).
ANTHROPIC_API_KEY=
DEFAULT_MODEL_PROVIDER=mock
DEFAULT_MODEL_NAME=claude-sonnet-5

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=daythree-api
LOG_LEVEL=INFO

# --- Seed admin (local Phase 0 auth only) ---
SEED_TENANT_CODE=daythree-hq
SEED_ADMIN_EMAIL=admin@daythree.local
SEED_ADMIN_PASSWORD=ChangeMe123!
